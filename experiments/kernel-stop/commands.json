{
  "scope": "Common recorded controls, verified for the nine closing runs; select the executable built from each retained build record.",
  "commands": [
    {
      "id": "placement",
      "executable": "llama-completion.exe",
      "arguments": [
        "-m",
        "<qwen3-model-gguf>",
        "-f",
        "<synthetic-benchmark-prompt>",
        "-c",
        "2048",
        "-n",
        "0",
        "-b",
        "512",
        "-ub",
        "128",
        "-t",
        "8",
        "-tb",
        "8",
        "--seed",
        "1234",
        "--samplers",
        "temperature",
        "--temp",
        "0",
        "--ignore-eos",
        "--no-conversation",
        "--simple-io",
        "--flash-attn",
        "auto",
        "--fit",
        "off",
        "--perf",
        "--offline",
        "--log-colors",
        "off",
        "--load-mode",
        "none",
        "--no-op-offload",
        "--moe-cache-mib",
        "2048",
        "--moe-cache-cpu-share",
        "0.95",
        "-ngl",
        "99",
        "--device",
        "CUDA0",
        "--override-tensor",
        "exps=CPU",
